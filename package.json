{
  "name": "modpack-assist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "description": "Gestor visual, diagnostico y optimizador de modpacks para Minecraft",
  "author": "Modpack Assist",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:react": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=development electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:electron": "electron-builder --win --x64",
    "build:exe": "npm run build && npm run build:electron"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "41.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.3",
    "vitest": "^5.1.1",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.5.17",
    "bottleneck": "^2.19.5",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reactflow": "^11.11.4",
    "systeminformation": "^5.31.6",
    "winston": "^3.13.0"
  }
}
