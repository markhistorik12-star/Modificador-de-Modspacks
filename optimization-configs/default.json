        "reduced_view_distance": 32,
        "fast_render": true
      },
      "particleculling.properties": {
        "cull_particles": true,
        "max_particles": 200
      },
      "connectivity.properties": {
        "timeout": 10000,
        "retry_attempts": 1
      },
      "farsight.toml": {
        "fake_chunks": false,
        "max_chunks": 256
      },
      "forge-client.toml": {
        "alwaysSetupTerrainOffThread": true
